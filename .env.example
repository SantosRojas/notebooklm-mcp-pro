# ── Autenticación ─────────────────────────────────────────────
# Ruta al storage_state.json generado con `notebooklm login`.
# Si se omite, notebooklm-py usa su ubicación por defecto / perfil activo.
# NLM_STORAGE_PATH=/home/usuario/.notebooklm/storage_state.json
# NLM_PROFILE=default

# ── Seguridad ─────────────────────────────────────────────────
# readonly (por defecto): solo se registran herramientas de lectura.
# readwrite: se registran además crear/añadir/editar.
NLM_MCP_MODE=readonly
# Solo tiene efecto con readwrite: habilita delete_source / delete_note / delete_notebook.
NLM_MCP_ALLOW_DESTRUCTIVE=0
# Carpetas desde las que se permite subir archivos (separadas por ':' en Linux/Mac, ';' en Windows).
# Vacío = add_source_file deshabilitada.
NLM_UPLOAD_DIRS=

# ── Rendimiento ───────────────────────────────────────────────
NLM_CACHE_DIR=
NLM_CACHE_TTL_SECONDS=3600
NLM_MAX_CHARS=20000
NLM_MAX_CONCURRENCY=4
NLM_TIMEOUT_SECONDS=60

# ── Operación ─────────────────────────────────────────────────
NLM_AUDIT_LOG=
# Rotación del registro de auditoría por tamaño (bytes). Mínimo 65536.
NLM_AUDIT_MAX_BYTES=10485760
NLM_LOG_LEVEL=INFO
# Reintento con backoff en lecturas (errores de red/servidor/cuota). Máx 5.
NLM_RETRIES=2
# Logs JSON en stderr (útil para ingesta/supervisión). Con 0, logs legibles.
NLM_LOG_JSON=0
# Recorta imágenes incrustadas (base64) del contenido Markdown de las fuentes.
# Los PDFs con screenshots vienen con MB de base64; por defecto se retiran
# y se reemplazan por marcadores de texto. Pon 0 si te van a hacer falta.
NLM_STRIP_IMAGES=1
